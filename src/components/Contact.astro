---
import type { Dict } from '../i18n';
import Twinkle from './Twinkle.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---
<section id={t.ids.contact} class="contact" aria-labelledby="h-contact">
  <Twinkle size={40} stroke="#EFE86A" class="absolute top-[36px] right-[8%]" />
  <div class="wrap contact-in">
    <h2 id="h-contact" class="serif reveal">{t.contact.h2}<svg aria-hidden="true" viewBox="0 0 220 20" preserveAspectRatio="none" fill="none"><path class="draw" pathLength="1" d="M4 12C60 4 140 3 216 9" stroke="#EFE86A" stroke-width="3" stroke-linecap="round"></path></svg></h2>
    <p class="reveal">{t.contact.text}</p>
    <WhatsAppButton t={t} variant="light" class="reveal" />
  </div>
</section>
