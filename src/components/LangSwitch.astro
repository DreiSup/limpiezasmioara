---
// Selector de idioma: enlaces normales, sin JS. variant header (con círculo a mano) o footer (subrayado).
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
  variant?: 'header' | 'footer';
}
const { t, variant = 'header' } = Astro.props;
const links = [
  { lang: 'es', href: '/', label: 'ES' },
  { lang: 'en', href: '/en/', label: 'EN' },
];
---
<nav aria-label={t.langNavLabel} class:list={['hand lang', { 'text-[18px]': variant === 'footer' }]}>
  {links.map((l) =>
    l.lang === t.lang ? (
      <a
        href={l.href}
        aria-current="page"
        class:list={{ 'underline underline-offset-[5px]': variant === 'footer' }}
      >{l.label}{variant === 'header' && (
        <svg aria-hidden="true" viewBox="0 0 46 46" fill="none"><path d="M10 25c-1-9 9-15 17-13 8 2 12 9 8 16-4 7-15 9-21 4-3-2-4-6-2-10 3-6 10-8 15-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" style="color: var(--pen)"></path></svg>
      )}</a>
    ) : (
      <a href={l.href} lang={l.lang} hreflang={l.lang}>{l.label}</a>
    )
  )}
</nav>
