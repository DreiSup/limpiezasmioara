---
import type { Dict } from '../i18n';
import { whatsappUrl } from '../config';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const z = t.zones;
// Lista de zonas: <ul> con un H3 por comarca (SEO §4; el <dl> de la referencia no era HTML válido).
// Iconos de zona (ola, naranja, huerta, torre): paths literales de la referencia.
---
<section id={t.ids.zones} class="sec" aria-labelledby="h-zones">
  <div class="wrap flex flex-col gap-[26px]">
    <h2 id="h-zones" class="serif h2 reveal">{z.h2}</h2>
    <ul class="zones">
      <li class="zone reveal"><svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="text-pen"><path d="M4 16c4-4 8-4 12 0s8 4 12 0 6-3 8-1"></path><path d="M4 24c4-4 8-4 12 0s8 4 12 0 6-3 8-1"></path></svg><div><h3>{z.items[0].name}</h3><p>{z.items[0].places}</p></div></li>
      <li class="zone reveal"><svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-pen"><circle cx="19" cy="23" r="11"></circle><path d="M19 12c0-3 1-5 3-6"></path><path d="M22 9c4-3 9-2 10 1-4 2-8 2-10-1Z"></path><path d="M14 20c1-2 3-3 5-3"></path></svg><div><h3>{z.items[1].name}</h3><p>{z.items[1].places}</p></div></li>
      <li class="zone reveal"><svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-pen"><path d="M20 34V18"></path><path d="M20 22c-6 0-10-4-10-10 6 0 10 4 10 10Z"></path><path d="M20 18c0-6 4-10 10-10 0 6-4 10-10 10Z"></path><path d="M8 34h24"></path></svg><div><h3>{z.items[2].name}</h3><p>{z.items[2].places}</p></div></li>
      <li class="zone reveal"><svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-pen"><path d="M9 34V14h4v-4h4v4h6v-4h4v4h4v20Z"></path><path d="M17 34v-7a3 3 0 0 1 6 0v7"></path></svg><div><h3>{z.items[3].name}</h3><p>{z.items[3].places}</p></div></li>
    </ul>
    <p class="hand note reveal mt-[4px]">{z.noteQuestion} <a href={whatsappUrl(t.whatsappMessage)} target="_blank" rel="noopener" class="font-[700] [text-decoration:underline_wavy] underline-offset-[5px]">{z.noteLink}</a></p>
  </div>
</section>
